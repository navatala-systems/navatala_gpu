#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer buf_procFaces {
  int procFaces[];
};
layout(std430, binding = 1) readonly buffer buf_counts {
  int counts[];
};
layout(std430, binding = 2) readonly buffer buf_phiCorr {
  float phiCorr[];
};
layout(std430, binding = 3) buffer buf_lambda {
  float lambda[];
};
layout(std430, binding = 4) readonly buffer buf_lambdapCell {
  float lambdapCell[];
};
layout(std430, binding = 5) readonly buffer buf_lambdamCell {
  float lambdamCell[];
};
layout(std430, binding = 6) readonly buffer buf_ownerAll {
  int ownerAll[];
};
layout(std430, binding = 7) readonly buffer buf_nbrLambdaP {
  float nbrLambdaP[];
};
layout(std430, binding = 8) readonly buffer buf_nbrLambdaM {
  float nbrLambdaM[];
};

// kernel: navatala_cfd_mules_proc_face_update
void main() {
  int gid0 = int(gl_GlobalInvocationID.x);
  if (int(int(gl_GlobalInvocationID.x)) >= counts[0]) {
    return;
  } else {
    int face = procFaces[int(int(gl_GlobalInvocationID.x))];
    int o = ownerAll[face];
    float pc = phiCorr[face];
    float lim = lambdamCell[o];
    float other = nbrLambdaP[int(int(gl_GlobalInvocationID.x))];
    if (lim > other) {
      lim = other;
    }
    if (pc > uintBitsToFloat(0x00000000u)) {
      float limPos = lambdapCell[o];
      float otherPos = nbrLambdaM[int(int(gl_GlobalInvocationID.x))];
      if (limPos > otherPos) {
        limPos = otherPos;
      }
      lim = limPos;
    }
    float cur = lambda[face];
    float _out = cur;
    if (_out > lim) {
      _out = lim;
    }
    lambda[face] = _out;
  }
}
