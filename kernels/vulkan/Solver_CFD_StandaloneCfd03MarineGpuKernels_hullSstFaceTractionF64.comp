#version 450
#extension GL_ARB_gpu_shader_fp64 : enable
double gpu_cbrt_pos_f64(double x) {
  double ax = (x > 0.0 ? x : 0.0);
  if (ax == 0.0) { return 0.0; }
  double y = double(pow(float(ax), 0.3333333432674408));
  if (y == 0.0) { y = 1.0e-100; }
  y = ((2.0 * y) + (ax / (y * y))) / 3.0;
  y = ((2.0 * y) + (ax / (y * y))) / 3.0;
  y = ((2.0 * y) + (ax / (y * y))) / 3.0;
  y = ((2.0 * y) + (ax / (y * y))) / 3.0;
  y = ((2.0 * y) + (ax / (y * y))) / 3.0;
  return y;
}

double gpu_pow_pos_f64_two_thirds(double x) {
  double r = gpu_cbrt_pos_f64(x);
  return r * r;
}

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer buf_wallShearOnFluidX {
  double wallShearOnFluidX[];
};
layout(std430, binding = 1) readonly buffer buf_wallShearOnFluidY {
  double wallShearOnFluidY[];
};
layout(std430, binding = 2) readonly buffer buf_wallShearOnFluidZ {
  double wallShearOnFluidZ[];
};
layout(std430, binding = 3) readonly buffer buf_fluidAreaVectorX {
  double fluidAreaVectorX[];
};
layout(std430, binding = 4) readonly buffer buf_fluidAreaVectorY {
  double fluidAreaVectorY[];
};
layout(std430, binding = 5) readonly buffer buf_fluidAreaVectorZ {
  double fluidAreaVectorZ[];
};
layout(std430, binding = 6) readonly buffer buf_faceCentroidX {
  double faceCentroidX[];
};
layout(std430, binding = 7) readonly buffer buf_faceCentroidY {
  double faceCentroidY[];
};
layout(std430, binding = 8) readonly buffer buf_faceCentroidZ {
  double faceCentroidZ[];
};
layout(std430, binding = 9) readonly buffer buf_hullSstDatum {
  double hullSstDatum[];
};
layout(std430, binding = 10) readonly buffer buf_nFaces {
  uint nFaces[];
};
layout(std430, binding = 11) writeonly buffer buf_areaOut {
  double areaOut[];
};
layout(std430, binding = 12) writeonly buffer buf_forceXOut {
  double forceXOut[];
};
layout(std430, binding = 13) writeonly buffer buf_forceYOut {
  double forceYOut[];
};
layout(std430, binding = 14) writeonly buffer buf_forceZOut {
  double forceZOut[];
};
layout(std430, binding = 15) writeonly buffer buf_momentXOut {
  double momentXOut[];
};
layout(std430, binding = 16) writeonly buffer buf_momentYOut {
  double momentYOut[];
};
layout(std430, binding = 17) writeonly buffer buf_momentZOut {
  double momentZOut[];
};

// kernel: Solver_CFD_StandaloneCfd03MarineGpuKernels_hullSstFaceTractionF64
void main() {
  int gid0 = int(gl_GlobalInvocationID.x);
  int gid = int(gl_GlobalInvocationID.x);
  int faceCount = int(nFaces[0]);
  if (gid < faceCount) {
    double areaX = fluidAreaVectorX[gid];
    double areaY = fluidAreaVectorY[gid];
    double areaZ = fluidAreaVectorZ[gid];
    double area = sqrt((((areaX * areaX) + (areaY * areaY)) + (areaZ * areaZ)));
    double forceX = ((-wallShearOnFluidX[gid]) * area);
    double forceY = ((-wallShearOnFluidY[gid]) * area);
    double forceZ = ((-wallShearOnFluidZ[gid]) * area);
    double momentArmX = (faceCentroidX[gid] - hullSstDatum[0]);
    double momentArmY = (faceCentroidY[gid] - hullSstDatum[1]);
    double momentArmZ = (faceCentroidZ[gid] - hullSstDatum[2]);
    double momentX = ((momentArmY * forceZ) - (momentArmZ * forceY));
    double momentY = ((momentArmZ * forceX) - (momentArmX * forceZ));
    double momentZ = ((momentArmX * forceY) - (momentArmY * forceX));
    areaOut[gid] = area;
    forceXOut[gid] = forceX;
    forceYOut[gid] = forceY;
    forceZOut[gid] = forceZ;
    momentXOut[gid] = momentX;
    momentYOut[gid] = momentY;
    momentZOut[gid] = momentZ;
  }
}
